.DS_Store
node_modules/
.vercel

# API responses. Rebuildable, and the player dictionary alone is 14MB.
.cache/

# Per-week headshots and crests, regenerated by assets.py before each report.
assets.json

# Assembled by site.js at deploy time. weeks/ is the committed source of truth.
public/

# Local dev's stand-in for the shared store.
.data/

# Superseded by weeks/ and public/.
report.html
shortlist.html

# Local secrets. The Upstash REST pair for one-off store maintenance; never committed.
.env
